{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "@mpsuesser/oxlint-plugin-effect",
  "version": "0.5.0",
  "description": "Oxlint JS plugin enforcing Effect-first development conventions",
  "keywords": [
    "effect",
    "eslint",
    "lint",
    "linter",
    "oxc",
    "oxlint",
    "oxlint-plugin",
    "oxlintplugin",
    "plugin",
    "rules",
    "typescript"
  ],
  "homepage": "https://github.com/mpsuesser/oxlint-plugin-effect",
  "bugs": {
    "url": "https://github.com/mpsuesser/oxlint-plugin-effect/issues"
  },
  "license": "MIT",
  "author": "Marc Suesser",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mpsuesser/oxlint-plugin-effect.git"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "licenses",
    "CHANGELOG.md"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./oxlint": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "check": "vp check --fix",
    "lint": "vp lint",
    "test": "vitest run",
    "typecheck": "tsgo",
    "prepare": "bunx --bun effect-tsgo patch",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@oxlint/plugins": "^1.66.0",
    "effect": "4.0.0",
    "effect-oxlint": "^0.3.3"
  },
  "devDependencies": {
    "@effect/tsgo": "^0.11.0",
    "@effect/vitest": "4.0.0",
    "@types/bun": "^1.3.14",
    "@typescript/native-preview": "^7.0.0-dev.20260523.1",
    "oxlint": "1.66.0",
    "tsdown": "^0.22.0",
    "typescript": "^6.0.3",
    "vite-plus": "^0.1.22",
    "vitest": "^4.1.7"
  },
  "overrides": {
    "effect": "4.0.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.1.22"
  },
  "packageManager": "bun@1.3.14"
}
